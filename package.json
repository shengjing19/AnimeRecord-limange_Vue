{
  "name": "animerecord-vue",
  "version": "1.1.0",
  "private": true,
  "description": "limange - 动漫记录",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets:prepare": "node scripts/prepare-assets.cjs",
    "desktop:dev": "npm run desktop:prepare && npm run build && electron .",
    "desktop:pack": "npm run desktop:prepare && npm run build && electron-builder --win --dir",
    "desktop:build": "npm run desktop:prepare && npm run assets:prepare && npm run build && electron-builder --win",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "desktop:prepare": "node scripts/ensure-electron.cjs",
    "test:performance": "node scripts/performance-check.cjs"
  },
  "dependencies": {
    "animejs": "^4.4.1",
    "axios": "^1.7.2",
    "echarts": "^5.5.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.10.0",
    "sharp": "^0.35.5",
    "vite": "^5.2.11"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "license": "GPL-3.0-only",
  "author": "Shengjing19"
